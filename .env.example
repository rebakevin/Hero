# Supabase (read by the app at startup)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_BUCKET=report-photos

# Firebase (reference only; the app uses lib/firebase_options.dart and android/app/google-services.json)
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_API_KEY=
FIREBASE_SENDER_ID=
